+.encuestas-container {
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: 20px;
+}
+
+/* Mensajes de estado */
+.mensaje {
+  padding: 12px 20px;
+  border-radius: 8px;
+  margin-bottom: 20px;
+  font-weight: 500;
+  animation: slideDown 0.3s ease-out;
+}
+
+.mensaje-success {
+  background-color: #d4edda;
+  color: #155724;
+  border: 1px solid #c3e6cb;
+}
+
+.mensaje-error {
+  background-color: #f8d7da;
+  color: #721c24;
+  border: 1px solid #f5c6cb;
+}
+
+.mensaje-warning {
+  background-color: #fff3cd;
+  color: #856404;
+  border: 1px solid #ffeaa7;
+}
+
+/* Indicador de carga */
+.loading {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 40px;
+  margin: 20px 0;
+}
+
+.spinner {
+  width: 40px;
+  height: 40px;
+  border: 4px solid var(--extra-light-blue);
+  border-top: 4px solid var(--secondary-blue);
+  border-radius: 50%;
+  animation: spin 1s linear infinite;
+}
+
+.loading p {
+  margin-top: 15px;
+  color: var(--medium-gray);
+  font-weight: 500;
+}
+
+/* Información de sesión */
+.session-info {
+  background: var(--pale-blue);
+  padding: 8px 15px;
+  border-radius: 8px;
+  margin-bottom: 20px;
+  text-align: center;
+  border: var(--border-light);
+}
+
+.session-info small {
+  color: var(--primary-blue);
+  font-size: 0.875rem;
+  font-weight: 500;
+}
+
+@keyframes slideDown {
+  from {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes spin {
+  0% { transform: rotate(0deg); }
+  100% { transform: rotate(360deg); }
+}
+
+.header {
+  text-align: center;
+  margin-bottom: 30px;
+}
+
+.header h2 {
+  color: var(--primary-blue);
+  margin-bottom: 10px;
+  font-size: 2.5rem;
+  font-weight: 700;
+}
+
+.header p {
+  color: var(--medium-gray);
+  margin: 0;
+  font-size: 1.1rem;
+}
+
+.encuestas-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
+  gap: 20px;
+}
+
+.encuesta-card {
+  background: var(--white);
+  border-radius: 12px;
+  box-shadow: var(--shadow-light);
+  padding: 24px;
+  cursor: pointer;
+  transition: all 0.3s ease;
+  border: var(--border-light);
+}
+
+.encuesta-card:hover:not(.vencida) {
+  transform: translateY(-4px);
+  box-shadow: var(--shadow-medium);
+  border-color: var(--light-blue);
+}
+
+.encuesta-card.vencida {
+  opacity: 0.6;
+  cursor: not-allowed;
+  background: var(--light-gray);
+}
+
+.encuesta-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  margin-bottom: 15px;
+}
+
+.encuesta-header h3 {
+  margin: 0;
+  color: var(--primary-blue);
+  font-size: 20px;
+  font-weight: 600;
+}
+
+.estado {
+  padding: 4px 8px;
+  border-radius: 4px;
+  font-size: 12px;
+  font-weight: 600;
+  text-transform: uppercase;
+}
+
+.estado.activa {
+  background: var(--extra-light-blue);
+  color: var(--primary-blue);
+}
+
+.estado.finalizada {
+  background: var(--light-gray);
+  color: var(--medium-gray);
+}
+
+.estado.borrador {
+  background: var(--pale-blue);
+  color: var(--hover-blue);
+}
+
+.descripcion {
+  color: var(--medium-gray);
+  margin-bottom: 15px;
+  line-height: 1.6;
+}
+
+.encuesta-info {
+  display: flex;
+  justify-content: space-between;
+  margin-bottom: 15px;
+}
+
+.encuesta-info small {
+  color: var(--medium-gray);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.btn-completar {
+  width: 100%;
+  padding: 12px;
+  background: var(--secondary-blue);
+  color: var(--white);
+  border: none;
