+
+    // Datos iniciales de encuestas
+    const encuestasIniciales: Encuesta[] = [
+      {
+        id: 1,
+        titulo: 'Satisfacción del Servicio',
+        descripcion: 'Encuesta para evaluar la calidad del servicio prestado',
+        fechaCreacion: new Date('2025-10-01'),
