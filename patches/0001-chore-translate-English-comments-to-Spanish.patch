+
+.escala-option {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  cursor: pointer;
+}
+
+.escala-option input[type="radio"] {
+  margin-bottom: 5px;
+}
+
+.escala-number {
+  font-weight: 600;
+  color: #333;
+}
+
+.escala-labels {
+  display: flex;
+  justify-content: space-between;
+  font-size: 12px;
+  color: #666;
+}
+
+/* Opción múltiple */
+.multiple-group {
+  margin-left: 20px;
+}
+
+.opcion-label {
+  display: block;
